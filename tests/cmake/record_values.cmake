# Checks counter values in a run's rank files:
#   cmake -DRECORD_DIR=<folder> -P record_values.cmake -- <expectation>...
# An expectation is <rank>:<NAME>=<value> (the "value" of counter NAME in
# n<rank>.json) or <rank>:<NAME>=<rank2>:<NAME2> (equal to that of NAME2 in
# n<rank2>.json).  Every expectation is checked, and every mismatch is named,
# before the check fails.
if(NOT DEFINED RECORD_DIR)
    message(FATAL_ERROR "record_values: -DRECORD_DIR= is required")
endif()
get_filename_component(RECORD_DIR "${RECORD_DIR}" ABSOLUTE)
set(_expect "")
set(_seen FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
    if(_seen)
        list(APPEND _expect "${CMAKE_ARGV${_i}}")
    elseif(CMAKE_ARGV${_i} STREQUAL "--")
        set(_seen TRUE)
    endif()
endforeach()
if(NOT _expect)
    message(FATAL_ERROR "record_values: no expectation after --")
endif()

# Sets <out> to the value of <rank>'s counter <name>, or to the reason it has
# none, in which case <ok> is FALSE.
function(_record_value rank name out ok)
    set(_file "${RECORD_DIR}/n${rank}.json")
    if(NOT EXISTS "${_file}")
        set(${out} "no ${_file}" PARENT_SCOPE)
        set(${ok} FALSE PARENT_SCOPE)
        return()
    endif()
    file(READ "${_file}" _json)
    string(JSON _v ERROR_VARIABLE _err GET "${_json}" counters ${name} value)
    if(_err)
        set(${out} "${_file} carries no ${name}" PARENT_SCOPE)
        set(${ok} FALSE PARENT_SCOPE)
        return()
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
    set(${ok} TRUE PARENT_SCOPE)
endfunction()

set(_bad "")
list(LENGTH _expect _count)
foreach(_e IN LISTS _expect)
    if(_e MATCHES "^([0-9]+):([A-Z0-9_]+)=([0-9]+):([A-Z0-9_]+)$")
        set(_rank ${CMAKE_MATCH_1})
        set(_name ${CMAKE_MATCH_2})
        set(_rank2 ${CMAKE_MATCH_3})
        set(_name2 ${CMAKE_MATCH_4})
        _record_value(${_rank} ${_name} _got _ok)
        _record_value(${_rank2} ${_name2} _ref _ok2)
        if(NOT _ok)
            list(APPEND _bad "${_got}")
        elseif(NOT _ok2)
            list(APPEND _bad "${_ref}")
        elseif(NOT _got STREQUAL _ref)
            string(CONCAT _m "rank ${_rank} ${_name} = ${_got}, "
                   "rank ${_rank2} ${_name2} = ${_ref}")
            list(APPEND _bad "${_m}")
        else()
            message(STATUS "record_values: rank ${_rank} ${_name} = rank "
                    "${_rank2} ${_name2} = ${_got}")
        endif()
    elseif(_e MATCHES "^([0-9]+):([A-Z0-9_]+)=([0-9]+)$")
        set(_rank ${CMAKE_MATCH_1})
        set(_name ${CMAKE_MATCH_2})
        set(_want ${CMAKE_MATCH_3})
        _record_value(${_rank} ${_name} _got _ok)
        if(NOT _ok)
            list(APPEND _bad "${_got}")
        elseif(NOT _got STREQUAL _want)
            list(APPEND _bad
                 "rank ${_rank} ${_name} = ${_got}, expected ${_want}")
        else()
            message(STATUS "record_values: rank ${_rank} ${_name} = ${_got}")
        endif()
    else()
        list(APPEND _bad "bad expectation '${_e}'")
    endif()
endforeach()
if(_bad)
    list(JOIN _bad "; " _bad)
    message(FATAL_ERROR "record_values: ${_bad}")
endif()
message(STATUS "record_values: ${_count} value(s) as expected")
