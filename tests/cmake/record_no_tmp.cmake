# Checks that a run left no temporary counter file behind:
#   cmake -P record_no_tmp.cmake -- <dir>...
# No file named *.tmp may exist under any given directory.
set(_dirs "")
set(_seen FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
    if(_seen)
        list(APPEND _dirs "${CMAKE_ARGV${_i}}")
    elseif(CMAKE_ARGV${_i} STREQUAL "--")
        set(_seen TRUE)
    endif()
endforeach()
if(NOT _dirs)
    message(FATAL_ERROR "record_no_tmp: no directory after --")
endif()
set(_left "")
foreach(_d IN LISTS _dirs)
    file(GLOB_RECURSE _tmp "${_d}/*.tmp")
    list(APPEND _left ${_tmp})
endforeach()
if(_left)
    message(FATAL_ERROR "record_no_tmp: temporary file(s) left: ${_left}")
endif()
message("record_no_tmp: no temporary file under ${_dirs}")
