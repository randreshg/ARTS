# Checks the fake CXL library's flush trace and region after a run:
#   cmake -P flush_trace_check.cmake -- <trace> <shm name>
# The trace must exist, open with the library's magic (0x4152545346434C58,
# little-endian) and count at least one entry; /dev/shm/<shm name> must not
# exist (the run's owner released its region).
set(_args "")
set(_seen FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
    if(_seen)
        list(APPEND _args "${CMAKE_ARGV${_i}}")
    elseif(CMAKE_ARGV${_i} STREQUAL "--")
        set(_seen TRUE)
    endif()
endforeach()
list(LENGTH _args _n)
if(NOT _n EQUAL 2)
    message(FATAL_ERROR "flush_trace_check: give the trace and the shm name")
endif()
list(GET _args 0 _trace)
list(GET _args 1 _shm)
set(_bad FALSE)
if(NOT EXISTS "${_trace}")
    message("flush_trace_check: no trace at ${_trace}")
    set(_bad TRUE)
else()
    file(READ "${_trace}" _head LIMIT 16 HEX)
    string(SUBSTRING "${_head}" 0 16 _magic)
    string(SUBSTRING "${_head}" 16 16 _count)
    if(NOT _magic STREQUAL "584c434653545241")
        message("flush_trace_check: ${_trace} opens with ${_magic}, not the "
                "trace's magic")
        set(_bad TRUE)
    elseif(_count STREQUAL "0000000000000000")
        message("flush_trace_check: ${_trace} counts no entry")
        set(_bad TRUE)
    else()
        message("flush_trace_check: ${_trace} holds a trace (count ${_count}, "
                "little-endian)")
    endif()
endif()
if(EXISTS "/dev/shm/${_shm}")
    message("flush_trace_check: /dev/shm/${_shm} still exists")
    set(_bad TRUE)
endif()
if(_bad)
    message(FATAL_ERROR "flush_trace_check: failed")
endif()
