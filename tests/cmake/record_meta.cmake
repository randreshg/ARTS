# Checks the metadata of a run's rank files (n<rank>.json):
#   cmake -DRECORD_DIR=<folder> -P record_meta.cmake -- <check>...
# A check is <key>=<value> (every rank file's metadata.<key> reads <value>),
# <key>@<rank>=<value> (n<rank>.json's does), with <key> origin or rc, or
# t0_spread_ms<=<n> (the rank files' t0_realtime_ns lie within n ms of one
# another).  Every check is made, and every failure named, before it fails.
if(NOT DEFINED RECORD_DIR)
    message(FATAL_ERROR "record_meta: -DRECORD_DIR= is required")
endif()
get_filename_component(RECORD_DIR "${RECORD_DIR}" ABSOLUTE)
set(_checks "")
set(_seen FALSE)
math(EXPR _last "${CMAKE_ARGC} - 1")
foreach(_i RANGE 0 ${_last})
    if(_seen)
        list(APPEND _checks "${CMAKE_ARGV${_i}}")
    elseif(CMAKE_ARGV${_i} STREQUAL "--")
        set(_seen TRUE)
    endif()
endforeach()
if(NOT _checks)
    message(FATAL_ERROR "record_meta: no check after --")
endif()

file(GLOB _all RELATIVE "${RECORD_DIR}" "${RECORD_DIR}/n*.json")
set(_ranks "")
foreach(_f IN LISTS _all)
    if(_f MATCHES "^n([0-9]+)\\.json$")
        list(APPEND _ranks ${CMAKE_MATCH_1})
    endif()
endforeach()
list(LENGTH _ranks _n)
if(_n EQUAL 0)
    message(FATAL_ERROR "record_meta: no rank file in ${RECORD_DIR}")
endif()
list(SORT _ranks COMPARE NATURAL)
foreach(_r IN LISTS _ranks)
    file(READ "${RECORD_DIR}/n${_r}.json" _json_${_r})
endforeach()

# Sets <out> to <rank>'s metadata.<key>, or to the reason it has none, in
# which case <ok> is FALSE.
function(_record_meta rank key out ok)
    if(NOT DEFINED _json_${rank})
        set(${out} "no ${RECORD_DIR}/n${rank}.json" PARENT_SCOPE)
        set(${ok} FALSE PARENT_SCOPE)
        return()
    endif()
    string(JSON _v ERROR_VARIABLE _err GET "${_json_${rank}}" metadata ${key})
    if(_err)
        set(${out} "n${rank}.json's metadata has no ${key}" PARENT_SCOPE)
        set(${ok} FALSE PARENT_SCOPE)
        return()
    endif()
    set(${out} "${_v}" PARENT_SCOPE)
    set(${ok} TRUE PARENT_SCOPE)
endfunction()

set(_bad "")
foreach(_c IN LISTS _checks)
    if(_c MATCHES "^t0_spread_ms<=([0-9]+)$")
        set(_limit_ms ${CMAKE_MATCH_1})
        set(_min "")
        set(_max "")
        set(_ok TRUE)
        foreach(_r IN LISTS _ranks)
            _record_meta(${_r} t0_realtime_ns _t _has)
            if(NOT _has OR NOT _t MATCHES "^[1-9][0-9]*$")
                list(APPEND _bad "n${_r}.json has no t0_realtime_ns stamp")
                set(_ok FALSE)
                continue()
            endif()
            if(_min STREQUAL "")
                set(_min ${_t})
                set(_max ${_t})
            else()
                math(EXPR _below "${_t} - ${_min}")
                math(EXPR _above "${_t} - ${_max}")
                if(_below LESS 0)
                    set(_min ${_t})
                endif()
                if(_above GREATER 0)
                    set(_max ${_t})
                endif()
            endif()
        endforeach()
        if(_ok)
            math(EXPR _spread "${_max} - ${_min}")
            math(EXPR _limit "${_limit_ms} * 1000000")
            math(EXPR _spread_us "${_spread} / 1000")
            if(_spread GREATER _limit)
                string(CONCAT _m "the t0 stamps of ${_n} rank(s) spread over "
                       "${_spread_us} us, above ${_limit_ms} ms")
                list(APPEND _bad "${_m}")
            else()
                message(STATUS "record_meta: the t0 stamps of ${_n} rank(s) "
                        "spread over ${_spread_us} us "
                        "(at most ${_limit_ms} ms)")
            endif()
        endif()
    elseif(_c MATCHES "^(origin|rc)(@([0-9]+))?=(.+)$")
        set(_key ${CMAKE_MATCH_1})
        set(_want "${CMAKE_MATCH_4}")
        if(CMAKE_MATCH_2)
            set(_which ${CMAKE_MATCH_3})
        else()
            set(_which ${_ranks})
        endif()
        foreach(_r IN LISTS _which)
            _record_meta(${_r} ${_key} _got _has)
            if(NOT _has)
                list(APPEND _bad "${_got}")
            elseif(NOT _got STREQUAL _want)
                list(APPEND _bad
                     "rank ${_r}'s ${_key} is ${_got}, not ${_want}")
            else()
                message(STATUS "record_meta: rank ${_r}'s ${_key} is ${_got}")
            endif()
        endforeach()
    else()
        list(APPEND _bad "bad check '${_c}'")
    endif()
endforeach()
if(_bad)
    list(JOIN _bad "; " _bad)
    message(FATAL_ERROR "record_meta: ${_bad}")
endif()
